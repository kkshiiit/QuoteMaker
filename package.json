{
  "name": "quotemaker",
  "private": true,
  "version": "1.2.0",
  "description": "QuoteMaker: cotizaciones profesionales para Android y web, con costos internos privados.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run build && npm run test:e2e",
    "cap:sync": "npm run build && cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "test:integration": "vitest run tests/integration",
    "test:live": "vitest run tests/live",
    "media": "node scripts/capture-media.mjs",
    "perf": "node scripts/measure-perf.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "@supabase/supabase-js": "2.119.0",
    "big.js": "7.0.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "jspdf": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "7.6.10",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/big.js": "7.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "jsonwebtoken": "9.0.3",
    "pdfjs-dist": "4.10.38",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  }
}
